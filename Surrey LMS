        // ========== CSV IMPORT ==========
        function processCSVImport() {
            const fileInput = document.getElementById('csvFileInput');
            const statusDiv = document.getElementById('importStatus');
            const uploadBtn = document.getElementById('startImportBtn');
            if (!fileInput.files.length) { alert("Please choose a CSV file first."); return; }
            const file = fileInput.files[0];
            const reader = new FileReader();
            uploadBtn.disabled = true;
            statusDiv.innerText = "Reading file...";
            reader.onload = function(e) {
                const text = e.target.result;
                const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
                if (lines.length <= 1) { alert("CSV file appears empty.");
                    uploadBtn.disabled = false; return; }
                const rows = lines.slice(1);
                let successCount = 0;
                const stored = getRecordsFromStorage();
                for (let i = 0; i < rows.length; i++) {
                    statusDiv.innerText = `Importing row ${i + 1} of ${rows.length}...`;
                    const cols = parseCSVLine(rows[i]);
                    if (cols.length < 4) continue;
                    const payload = {
                        id: generateId(),
                        date: cols[0] ? cols[0].replace(/^"|"$/g, '').trim() : new Date().toISOString().split('T')[0],
                        time: cols[1] ? cols[1].replace(/^"|"$/g, '').trim() : '',
                        grade: cols[2] ? cols[2].replace(/^"|"$/g, '').trim() : '',
                        first_name: cols[3] ? cols[3].replace(/^"|"$/g, '').trim() : '',
                        last_name: cols[4] ? cols[4].replace(/^"|"$/g, '').trim() : '',
                        learner_id: cols[5] ? cols[5].replace(/^"|"$/g, '').trim() : '',
                        category: cols[6] ? cols[6].replace(/^"|"$/g, '').trim() : 'General',
                        severity: cols[7] ? cols[7].replace(/^"|"$/g, '').trim() : 'Ordinary Offence',
                        action_taken: cols[8] ? cols[8].replace(/^"|"$/g, '').trim() : 'Warning',
                        location: cols[9] ? cols[9].replace(/^"|"$/g, '').trim() : '',
                        intervention_status: cols[10] ? cols[10].replace(/^"|"$/g, '').trim() : 'Pending',
                        consequence_start: cols[11] ? cols[11].replace(/^"|"$/g, '').trim() : '',
                        consequence_end: cols[12] ? cols[12].replace(/^"|"$/g, '').trim() : '',
                        reporter: cols[13] ? cols[13].replace(/^"|"$/g, '').trim() : '',
                        witnesses: cols[14] ? cols[14].replace(/^"|"$/g, '').trim() : '',
                        notes: cols[15] ? cols[15].replace(/^"|"$/g, '').trim() : '',
                        record_type: cols[16] ? cols[16].replace(/^"|"$/g, '').trim().toLowerCase() : 'infraction'
                    };
                    stored.push(payload);
                    successCount++;
                }
                saveRecordsToStorage(stored);
                records = stored;
                records.reverse();
                statusDiv.innerText = `Completed! ${successCount} record(s) imported.`;
                uploadBtn.disabled = false;
                fileInput.value = "";
                calculateLearnerCounts();
                updateDashboard();
                renderCharts();
                renderMeritCharts();
                renderRecords();
                renderAdvancedAnalytics();
                setTimeout(() => closeModal('importModal'), 1500);
            };
            reader.readAsText(file);
        }

