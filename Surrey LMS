        function renderWordCloud() {
            const container = document.getElementById('wordCloudContainer');
            const notes = records.filter(r => r.notes && r.notes.trim().length > 0 && r.record_type !== 'parent_info')
                .map(r => r.notes);
            if (notes.length === 0) { container.innerHTML = '<div class="no-data">No notes to analyze.</div>'; return; }
            const text = notes.join(' ').toLowerCase();
            const words = text.split(/\s+/).filter(w => w.length > 2);
            const stopWords = ['the', 'and', 'for', 'with', 'not', 'but', 'has', 'was', 'are', 'his', 'her', 'she', 'he',
                'from', 'have', 'they', 'this', 'that', 'you', 'your', 'will', 'said', 'were', 'been', 'can', 'out',
                'one', 'all', 'would', 'there', 'their', 'what', 'when', 'who', 'which', 'about', 'after', 'because',
                'even', 'into', 'some', 'such', 'than', 'that', 'then', 'thence', 'these', 'they', 'this', 'those',
                'through', 'unto', 'when', 'where', 'whereby', 'wherein', 'whereof', 'wherewith', 'whether', 'which',
                'while', 'who', 'whom', 'whose', 'without', 'etc', 'also', 'may', 'very', 'too', 'just', 'like',
                'make', 'see', 'way', 'well', 'think', 'know', 'need', 'take', 'come', 'use', 'find', 'give', 'tell',
                'work', 'call', 'try', 'ask', 'get', 'place', 'end', 'live', 'another', 'each', 'own', 'same', 'most'
            ];
            const wordFreq = {};
            words.forEach(w => { if (!stopWords.includes(w) && w.length > 2) { wordFreq[w] = (wordFreq[w] || 0) + 1; } });
            const sortedWords = Object.entries(wordFreq).sort((a, b) => b[1] - a[1]).slice(0, 30);
            if (sortedWords.length === 0) { container.innerHTML = '<div class="no-data">No meaningful words found.</div>'; return; }
            const maxFreq = sortedWords[0][1];
            container.innerHTML = sortedWords.map(([word, freq]) => {
                const size = Math.min(5, Math.ceil((freq / maxFreq) * 5));
                return `<span class="word-size-${size}" style="opacity:${0.6 + (freq/maxFreq)*0.4};">${word}</span>`;
            }).join('');
        }

        function renderLearnerHealthTable() {
            const tbody = document.getElementById('learnerHealthBody');
            const learnerData = {};
            records.forEach(r => {
                const key =
                    `${(r.first_name || '').toLowerCase().trim()}_${(r.last_name || '').toLowerCase().trim()}`;
                if (!learnerData[key]) {
                    learnerData[key] = { first_name: r.first_name, last_name: r.last_name, grade: r.grade,
                        infractions: 0, merits: 0, meritPoints: 0 };
                }
                if (r.record_type === 'merit') {
                    learnerData[key].merits++;
                    const ptsMatch = (r.severity || '').match(/(\d+)/);
                    const pts = ptsMatch ? parseInt(ptsMatch[1], 10) : 5;
                    learnerData[key].meritPoints += pts;
                } else if (r.record_type !== 'parent_info' && r.severity !== 'Merit Award') {
                    learnerData[key].infractions++;
                }
                if (r.grade) learnerData[key].grade = r.grade;
            });
            const learners = Object.values(learnerData);
            if (learners.length === 0) { tbody.innerHTML = `<tr><td colspan="7" class="no-data">No learner data available.</td></tr>`; return; }
            learners.forEach(l => {
                const inf = l.infractions || 1;
                const mp = l.meritPoints || 0;
                l.healthScore = Math.min(100, Math.round((mp / (inf + 1)) * 10));
                if (l.healthScore >= 70) l.status = 'Excellent';
                else if (l.healthScore >= 50) l.status = 'Good';
                else if (l.healthScore >= 30) l.status = 'Needs Support';
                else l.status = 'At Risk';
            });
            learners.sort((a, b) => a.healthScore - b.healthScore);
            tbody.innerHTML = learners.map(l => `
                    <tr>
                        <td><strong>${l.first_name} ${l.last_name}</strong></td>
                        <td>${l.grade}</td>
                        <td style="color:#dc2626;">${l.infractions}</td>
                        <td style="color:#16a34a;">${l.merits}</td>
                        <td>${l.meritPoints}</td>
                        <td><strong>${l.healthScore}</strong></td>
                        <td><span class="tag ${l.status === 'Excellent' ? 'tag-merit' : l.status === 'Good' ? 'tag-ordinary' : 'tag-serious'}">${l.status}</span></td>
                    </tr>
                `).join('');
        }

