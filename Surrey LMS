        async function addPrefectSubmit() {
            const name = document.getElementById('newPrefectName').value.trim();
            const role = document.getElementById('newPrefectRole').value;
            const status = document.getElementById('newPrefectStatus').value;
            if (!name) { alert("Please enter a name."); return; }

            const maxOrder = prefects.reduce((max, p) => Math.max(max, Number(p.order) || 0), 0);
            const newPrefect = {
                id: generateId(),
                name: name,
                role: role,
                status: status,
                contractSigned: false,
                badgePaid: false,
                order: maxOrder + 1
            };

            // Save locally immediately for a fast UI response, then send the same
            // record to the shared Google Sheet.
            prefects.push(newPrefect);
            savePrefectsToStorage(prefects);
            renderPrefects();
            updatePrefectStats();
            closeModal('addPrefectModal');
            showToast("⏳ Saving prefect to Google Sheets...");

            const saved = await savePrefectToGoogleSheets(newPrefect);
            if (saved) {
                showToast("✅ Prefect added and saved to Google Sheets.");
                // Re-fetch so the browser uses the exact cloud copy.
                await syncWithGoogleSheets();
            } else {
                showToast("⚠️ Prefect added locally, but the Google Sheets save could not be confirmed.");
            }
        }

