        function renderHeatmap() {
            const container = document.getElementById('heatmapContainer');
            const infractions = records.filter(r => r.record_type !== 'merit' && r.record_type !== 'parent_info' && r
                .severity !== 'Merit Award');
            const locations = [...new Set(infractions.map(r => r.location).filter(Boolean))];
            const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
            const matrix = {};
            locations.forEach(l => { matrix[l] = {};
                days.forEach(d => matrix[l][d] = 0); });
            infractions.forEach(r => {
                const d = parseLocalDate(r.date);
                if (d && r.location) {
                    const dayName = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][d
                        .getDay()];
                    if (matrix[r.location] && matrix[r.location][dayName] !== undefined) {
                        matrix[r.location][dayName]++;
                    }
                }
            });
            if (locations.length === 0) { container.innerHTML = '<div class="no-data">No data for heatmap.</div>'; return; }
            let maxVal = 0;
            for (const l in matrix)
                for (const d in matrix[l])
                    if (matrix[l][d] > maxVal) maxVal = matrix[l][d];
            let html =
                `<table class="heatmap-table"><thead><tr><th>Location</th>${days.map(d => `<th>${d}</th>`).join('')}</tr></thead><tbody>`;
            locations.forEach(l => {
                html += `<tr><td><strong>${l}</strong></td>`;
                days.forEach(d => {
                    const val = matrix[l][d] || 0;
                    const intensity = maxVal > 0 ? Math.round((val / maxVal) * 255) : 0;
                    const color = `rgb(${255 - intensity}, ${255 - intensity * 0.5}, ${255 - intensity})`;
                    html += `<td style="background:${color};font-weight:bold;">${val}</td>`;
                });
                html += `</tr>`;
            });
            html += `</tbody></table>`;
            container.innerHTML = html;
        }

