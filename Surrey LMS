        function renderPredictiveAlerts() {
            const container = document.getElementById('predictiveAlertsContainer');
            const infractions = records.filter(r => r.record_type !== 'merit' && r.record_type !== 'parent_info' && r
                .severity !== 'Merit Award');
            const now = new Date();
            const thirtyDaysAgo = new Date(now);
            thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

            const learnerInfractions = {};
            infractions.forEach(r => {
                const key =
                    `${(r.first_name || '').toLowerCase().trim()}_${(r.last_name || '').toLowerCase().trim()}`;
                if (!learnerInfractions[key]) {
                    learnerInfractions[key] = { first_name: r.first_name, last_name: r.last_name, grade: r.grade,
                        count: 0, recent: 0 };
                }
                learnerInfractions[key].count++;
                const d = parseLocalDate(r.date);
                if (d && d >= thirtyDaysAgo) learnerInfractions[key].recent++;
            });

            let alerts = [];
            for (const key in learnerInfractions) {
                const l = learnerInfractions[key];
                if (l.count >= 5) {
                    alerts.push({ type: 'danger', message: `${l.first_name} ${l.last_name} (${l.grade}) has ${l.count} total infractions (high risk)`, detail: 'Consider intervention and parent meeting.' });
                } else if (l.recent >= 3) {
                    alerts.push({ type: 'warning', message: `${l.first_name} ${l.last_name} (${l.grade}) has ${l.recent} infractions in the last 30 days`, detail: 'Recent spike in behavior issues. Monitor closely.' });
                }
            }

            const meritLearners = {};
            records.filter(r => r.record_type === 'merit').forEach(r => {
                const key =
                    `${(r.first_name || '').toLowerCase().trim()}_${(r.last_name || '').toLowerCase().trim()}`;
                meritLearners[key] = true;
            });
            for (const key in learnerInfractions) {
                if (!meritLearners[key] && learnerInfractions[key].count >= 2) {
                    alerts.push({ type: 'warning', message: `${learnerInfractions[key].first_name} ${learnerInfractions[key].last_name} (${learnerInfractions[key].grade}) has infractions but no merits`, detail: 'Encourage positive behavior recognition.' });
                }
            }

            if (alerts.length === 0) {
                container.innerHTML = `<div class="no-data" style="padding:10px;">✅ No predictive alerts at this time.</div>`;
                return;
            }
            container.innerHTML = alerts.map(a => `
                    <div class="alert-card ${a.type === 'danger' ? 'danger' : ''}">
                        <div class="alert-title">${a.type === 'danger' ? '🚨' : '⚠️'} ${a.message}</div>
                        <div class="alert-detail">${a.detail}</div>
                    </div>
                `).join('');
        }

