            records.forEach(r => {
                const key =
                    `${(r.first_name || '').toLowerCase().trim()}_${(r.last_name || '').toLowerCase().trim()}`;
                if (r.record_type === 'merit') {
                    learnerMerits[key] = (learnerMerits[key] || 0) + 1;
                    const ptsMatch = (r.severity || '').match(/(\d+)/);
                    const pts = ptsMatch ? parseInt(ptsMatch[1], 10) : 5;
                    learnerMeritPoints[key] = (learnerMeritPoints[key] || 0) + pts;
                } else if (r.record_type !== 'parent_info') {
                    learnerCounts[key] = (learnerCounts[key] || 0) + 1;
                }
            });
