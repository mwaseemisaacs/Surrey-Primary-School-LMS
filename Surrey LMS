        async function addDutySubmit() {
            const prefectId = document.getElementById('dutyPrefectSelect').value;
            const date = document.getElementById('dutyDate').value;
            const time = document.getElementById('dutyTime').value;
            const location = document.getElementById('dutyLocation').value.trim();
            const task = document.getElementById('dutyTask').value.trim();
            if (!prefectId || !date || !time || !location || !task) { alert("Please fill in all fields."); return; }
            const newDuty = {
                id: generateId(),
                prefectId: prefectId,
                date: date,
                time: time,
                location: location,
                task: task,
                status: 'Assigned'
            };
            duties.push(newDuty);
            saveDutiesToStorage(duties);
            await saveDutyToGoogleSheets(newDuty);
            closeModal('addDutyModal');
            renderDuties();
            updatePrefectStats();
            showToast("Duty assigned successfully!");
        }

        async function updateDutyStatus(id, newStatus) {
            const d = duties.find(duty => String(duty.id) === String(id));
            if (!d) return;
            d.status = newStatus;
            saveDutiesToStorage(duties);
            renderDuties();
            updatePrefectStats();
            // The existing Apps Script currently supports append-only writes for duties.
            // Keep the local state immediately responsive; cloud update requires the same
            // action-based backend support used by prefect updates.
            await sendSheetAction("update", "Duties", d.id, {
                prefectId: d.prefectId, date: d.date, time: d.time, location: d.location, task: d.task, status: d.status
            });
            showToast(`Duty status updated to ${newStatus}`);
        }

        async function deleteDuty(id) {
            if (!confirm("Delete this duty assignment?")) return;
            duties = duties.filter(d => String(d.id) !== String(id));
            saveDutiesToStorage(duties);
            renderDuties();
            updatePrefectStats();
            await sendSheetAction("delete", "Duties", id);
            showToast("Duty deleted.");
        }

        function renderDuties() {
            const tbody = document.getElementById('dutyTableBody');
            const dateFilter = document.getElementById('dutyDateFilter').value;
            const statusFilter = document.getElementById('dutyStatusFilter').value;
            const prefectFilter = document.getElementById('dutyPrefectFilter').value;

            const filterSelect = document.getElementById('dutyPrefectFilter');
            if (filterSelect.options.length <= 1) {
                filterSelect.innerHTML = '<option value="ALL">All Prefects</option>';
                prefects.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.name;
                    filterSelect.appendChild(opt);
                });
            }

            let filtered = [...duties];
            if (dateFilter) filtered = filtered.filter(d => d.date === dateFilter);
            if (statusFilter !== 'ALL') filtered = filtered.filter(d => d.status === statusFilter);
            if (prefectFilter !== 'ALL') filtered = filtered.filter(d => d.prefectId === prefectFilter);

            filtered.sort((a, b) => (a.date > b.date ? -1 : 1));

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="no-data">No duties assigned.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(d => {
                const prefect = prefects.find(p => p.id === d.prefectId);
                const statusClass = d.status === 'Assigned' ? 'tag-pending' :
                    d.status === 'Completed' ? 'tag-merit' : 'tag-serious';
                return `
                        <tr>
                            <td>${d.date}</td>
                            <td><strong>${prefect ? prefect.name : 'Unknown'}</strong></td>
                            <td>${d.time}</td>
                            <td>${d.location}</td>
                            <td>${d.task}</td>
                            <td><span class="tag ${statusClass}">${d.status}</span></td>
                            <td>
