            let list = records.filter(r => {
                if (currentRecordTab === 'infractions') {
                    return r.record_type !== 'merit' && r.record_type !== 'parent_info' && r.severity !== 'Merit Award';
                } else if (currentRecordTab === 'merits') {
                    return r.record_type === 'merit';
                } else if (currentRecordTab === 'parents') {
                    return r.record_type === 'parent_info';
                }
                return true;
            });

            if (selectedGrade !== 'ALL') list = list.filter(r => r.grade === selectedGrade);
            if (selectedOffenders === 'REPEAT' && currentRecordTab === 'infractions') {
                list = list.filter(r => {
                    const key =
                        `${(r.first_name || '').toLowerCase().trim()}_${(r.last_name || '').toLowerCase().trim()}`;
                    return (learnerCounts[key] || 0) >= 3;
                });
            }
            if (searchVal) {
                list = list.filter(r => {
                    const fullName = `${r.first_name || ''} ${r.last_name || ''}`.toLowerCase();
                    const notes = (r.notes || '').toLowerCase();
                    const category = (r.category || '').toLowerCase();
                    return fullName.includes(searchVal) || notes.includes(searchVal) || category.includes(searchVal);
                });
            }
            if (currentSortColumn) {
                list.sort((a, b) => {
                    let valA = (a[currentSortColumn] || '').toString().toLowerCase();
                    let valB = (b[currentSortColumn] || '').toString().toLowerCase();
                    if (currentSortColumn === 'date') { valA = a.date || '';
                        valB = b.date || ''; }
                    if (valA < valB) return currentSortDirection === 'asc' ? -1 : 1;
                    if (valA > valB) return currentSortDirection === 'asc' ? 1 : -1;
                    return 0;
                });
            }
            return list;
        }

        function updateSubTabCounts() {
            const infractions = records.filter(r => r.record_type !== 'merit' && r.record_type !== 'parent_info' && r
                .severity !== 'Merit Award');
            const merits = records.filter(r => r.record_type === 'merit');
            const parents = records.filter(r => r.record_type === 'parent_info');
            document.getElementById('countInfractionTab').innerText = infractions.length;
            document.getElementById('countMeritTab').innerText = merits.length;
            document.getElementById('countParentTab').innerText = parents.length;
        }

        function renderRecords() {
            updateSubTabCounts();
            const tbody = document.getElementById('recordsTableBody');
            const thead = document.getElementById('recordsTableHeader');
            const filteredList = getFilteredRecords();

            if (currentRecordTab === 'infractions') {
                thead.innerHTML = `<tr><th class="sortable" onclick="sortTable('date')">Date ↕</th><th class="sortable" onclick="sortTable('time')">Time ↕</th>
                        <th class="sortable" onclick="sortTable('grade')">Class ↕</th><th class="sortable" onclick="sortTable('first_name')">Learner ↕</th>
                        <th class="sortable" onclick="sortTable('category')">Category ↕</th><th class="sortable" onclick="sortTable('severity')">Classification ↕</th>
                        <th>Action</th><th>Location</th><th>Status</th><th>Actions</th></tr>`;
                if (filteredList.length === 0) { tbody.innerHTML =
                        `<tr><td colspan="10" class="no-data">No infraction records found.</td></tr>`; return; }
                tbody.innerHTML = filteredList.map(r => {
                    const key =
                        `${(r.first_name || '').toLowerCase().trim()}_${(r.last_name || '').toLowerCase().trim()}`;
                    const totalInf = learnerCounts[key] || 0;
                    let rowClass = "",
                        badge = "";
                    if (totalInf >= 5) { rowClass = "offender-danger";
                        badge =
                            `<span class="tag badge-danger" title="${totalInf} total">🔥 ${totalInf}</span>`; } else if (
                        totalInf >= 3) { rowClass = "offender-warning";
                        badge =
                            `<span class="tag badge-warning" title="${totalInf} total">⚠️ ${totalInf}</span>`; }
                    const isSerious = r.severity && r.severity.includes("Serious");
                    const tagClass = isSerious ? "tag-serious" : "tag-ordinary";
                    const statusClass = (r.intervention_status || 'Pending').toLowerCase().replace(' ', '-');
                    return `
                            <tr class="${rowClass}">
                                <td>${r.date || ''}</td><td>${r.time || '--'}</td>
                                <td><strong>${r.grade || ''}</strong></td>
                                <td><strong>${r.first_name || ''} ${r.last_name || ''}</strong> ${badge}
                                    <div class="learner-btns">
                                        <button class="pdf-btn" onclick="generateLearnerPDF('${(r.first_name || '').replace(/'/g, "\\'")}', '${(r.last_name || '').replace(/'/g, "\\'")}')">📄 Profile</button>
                                        <button class="parent-btn" onclick="generateParentLetter('${r.id}')">✉️ Notice</button>
                                    </div>
                                </td>
                                <td>${r.category || ''}</td>
                                <td><span class="tag ${tagClass}">${r.severity || 'Ordinary'}</span></td>
                                <td>${r.action_taken || ''}</td>
                                <td>${r.location || '--'}</td>
                                <td><span class="status-badge ${statusClass}">${r.intervention_status || 'Pending'}</span></td>
                                <td><div class="action-btns"><button class="edit-btn" onclick="openEditModal('${r.id}')">✏️</button><button class="delete-btn" onclick="deleteRecord('${r.id}')">🗑️</button></div></td>
                            </tr>
                        `;
                }).join('');

            } else if (currentRecordTab === 'merits') {
                thead.innerHTML = `<tr><th class="sortable" onclick="sortTable('date')">Date ↕</th><th class="sortable" onclick="sortTable('grade')">Class ↕</th>
                        <th class="sortable" onclick="sortTable('first_name')">Learner ↕</th><th class="sortable" onclick="sortTable('merit_badge')">Badge ↕</th>
                        <th class="sortable" onclick="sortTable('category')">Category ↕</th><th class="sortable" onclick="sortTable('severity')">Points ↕</th>
                        <th>Teacher</th><th>Certificate</th><th>Actions</th></tr>`;
                if (filteredList.length === 0) { tbody.innerHTML =
                        `<tr><td colspan="9" class="no-data">No merit records found.</td></tr>`; return; }
                tbody.innerHTML = filteredList.map(r => `
                        <tr>
                            <td>${r.date || ''}</td><td><strong>${r.grade || ''}</strong></td>
                            <td><strong>${r.first_name || ''} ${r.last_name || ''}</strong>
                                <div class="learner-btns"><button class="pdf-btn" onclick="generateLearnerPDF('${(r.first_name || '').replace(/'/g, "\\'")}', '${(r.last_name || '').replace(/'/g, "\\'")}')">📄 Profile</button></div>
                            </td>
                            <td><span class="tag tag-merit">${r.merit_badge || '--'}</span></td>
                            <td>${r.category || ''}</td>
                            <td><span class="tag tag-merit">${r.severity || '+5'}</span></td>
                            <td>${r.awarding_teacher || '--'}</td>
                            <td>${r.certificate_issued === 'Yes' ? '✅ Yes' : '❌ No'}</td>
                            <td><div class="action-btns"><button class="cert-btn" onclick="generateMeritCertificate('${r.id}')">📜 Cert</button><button class="edit-btn" onclick="openEditModal('${r.id}')">✏️</button><button class="delete-btn" onclick="deleteRecord('${r.id}')">🗑️</button></div></td>
                        </tr>
                    `).join('');

            } else if (currentRecordTab === 'parents') {
                thead.innerHTML = `<tr><th class="sortable" onclick="sortTable('date')">Date ↕</th><th class="sortable" onclick="sortTable('grade')">Class ↕</th>
                        <th class="sortable" onclick="sortTable('first_name')">Learner ↕</th><th>Primary Guardian</th><th>Contact</th><th>POPIA</th><th>Medical</th><th>Actions</th></tr>`;
                if (filteredList.length === 0) { tbody.innerHTML =
                        `<tr><td colspan="8" class="no-data">No parent records found.</td></tr>`; return; }
                tbody.innerHTML = filteredList.map(r => {
                    let parsed = {};
                    try { parsed = JSON.parse(r.notes || '{}'); } catch (e) {}
                    return `
                            <tr>
                                <td>${r.date || ''}</td><td><strong>${r.grade || ''}</strong></td>
                                <td><strong>${r.first_name || ''} ${r.last_name || ''}</strong></td>
                                <td>${parsed.primaryGuardian || 'N/A'}</td>
                                <td>${parsed.primaryPhone || 'N/A'}</td>
                                <td><span class="tag ${parsed.popia === 'YES' ? 'tag-merit' : 'tag-serious'}">${parsed.popia || 'N/A'}</span></td>
                                <td>${parsed.chronic === 'YES' ? (parsed.illnesses || 'Yes') : 'None'}</td>
                                <td><div class="action-btns"><button class="pdf-btn" onclick="generateParentInfoPDF('${r.id}')">📄 PDF</button><button class="edit-btn" onclick="openEditModal('${r.id}')">✏️</button><button class="delete-btn" onclick="deleteRecord('${r.id}')">🗑️</button></div></td>
                            </tr>
                        `;
                }).join('');
            }
        }
    </script>
</body>
</html>
