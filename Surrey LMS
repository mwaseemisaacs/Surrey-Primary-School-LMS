        async function resolveConsequence(id) {
            const c = consequences.find(con => String(con.id) === String(id));
            if (!c) return;
            c.status = 'Resolved';
            saveConsequencesToStorage(consequences);
            renderConsequences();
            await sendSheetAction("update", "Consequences", c.id, {
                prefectId: c.prefectId, date: c.date, level: c.level, reason: c.reason, status: c.status
            });
            showToast("Consequence resolved.");
        }

        async function deleteConsequence(id) {
            if (!confirm("Delete this consequence record?")) return;
            consequences = consequences.filter(c => String(c.id) !== String(id));
            saveConsequencesToStorage(consequences);
            renderConsequences();
            await sendSheetAction("delete", "Consequences", id);
            showToast("Consequence deleted.");
        }

        function renderConsequences() {
            const tbody = document.getElementById('consequenceTableBody');
            const prefectFilter = document.getElementById('consequencePrefectFilter').value;
            const levelFilter = document.getElementById('consequenceLevelFilter').value;

            const filterSelect = document.getElementById('consequencePrefectFilter');
            if (filterSelect.options.length <= 1) {
                filterSelect.innerHTML = '<option value="ALL">All Prefects</option>';
                prefects.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.name;
                    filterSelect.appendChild(opt);
                });
            }

            let filtered = [...consequences];
            if (prefectFilter !== 'ALL') filtered = filtered.filter(c => c.prefectId === prefectFilter);
            if (levelFilter !== 'ALL') filtered = filtered.filter(c => c.level === levelFilter);

            filtered.sort((a, b) => (a.date > b.date ? -1 : 1));

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="no-data">No consequences recorded.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(c => {
                const prefect = prefects.find(p => p.id === c.prefectId);
                const levelClass = c.level === 'Verbal Warning' ? 'verbal' :
                    c.level === 'Written Warning' ? 'written' :
                    c.level === 'Removal of Privileges' ? 'privilege' :
                    c.level === 'Temporary Suspension' ? 'suspension' :
                    c.level === 'Permanent Removal' ? 'removal' : 'referral';
                return `
                        <tr>
                            <td>${c.date}</td>
                            <td><strong>${prefect ? prefect.name : 'Unknown'}</strong></td>
                            <td><span class="consequence-level ${levelClass}">${c.level}</span></td>
