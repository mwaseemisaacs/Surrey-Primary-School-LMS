        async function syncWithGoogleSheets() {
            if (isSyncing) return;
            isSyncing = true;
            const syncBtn = document.getElementById('syncSheetBtn');
            const originalText = syncBtn ? syncBtn.innerHTML : '';
            if (syncBtn) {
                syncBtn.disabled = true;
                syncBtn.innerHTML = '⏳ Syncing...';
            }
            showToast("🔄 Syncing with Google Sheets...");

            try {
                const [infractions, merits, parents, prefectRows, dutyRows, consequenceRows] = await Promise.all([
                    fetchSheetData("Infractions"),
                    fetchSheetData("Merits"),
                    fetchSheetData("Parents"),
                    fetchSheetData("Prefects"),
                    fetchSheetData("Duties"),
                    fetchSheetData("Consequences")
                ]);

                // Learner/parent records continue to merge into the existing local cache.
                let newRecords = [];
                infractions.forEach(row => newRecords.push(convertSheetRowToRecord(row, "Infractions")));
                merits.forEach(row => newRecords.push(convertSheetRowToRecord(row, "Merits")));
                parents.forEach(row => newRecords.push(convertSheetRowToRecord(row, "Parents")));

                if (lastSuccessfulSheetFetch.Infractions || lastSuccessfulSheetFetch.Merits || lastSuccessfulSheetFetch.Parents) {
                    const existingRecords = getRecordsFromStorage();
                    const existingIds = new Set(existingRecords.map(r => String(r.id)));
                    const toAdd = newRecords.filter(r => !existingIds.has(String(r.id)));
                    if (toAdd.length > 0) {
                        const merged = [...existingRecords, ...toAdd];
                        saveRecordsToStorage(merged);
                        records = merged;
                    }
                }

                // IMPORTANT: Prefects, Duties and Consequences use Google Sheets as the
                // shared/master source. This is what makes the data appear on every PC.
                if (lastSuccessfulSheetFetch.Prefects) {
                    prefects = prefectRows.map(convertSheetRowToPrefect).filter(p => p.name && p.name.toLowerCase() !== 'name');
                    prefects.sort((a, b) => (a.order || 0) - (b.order || 0));
                    savePrefectsToStorage(prefects);
                }

                if (lastSuccessfulSheetFetch.Duties) {
                    duties = dutyRows.map(convertSheetRowToDuty).filter(d => d.id && d.prefectId && d.id.toLowerCase() !== 'id');
                    saveDutiesToStorage(duties);
                }

                if (lastSuccessfulSheetFetch.Consequences) {
                    consequences = consequenceRows.map(convertSheetRowToConsequence).filter(c => c.id && c.prefectId && c.id.toLowerCase() !== 'id');
                    saveConsequencesToStorage(consequences);
                }

                records = getRecordsFromStorage();
                calculateLearnerCounts();
                updateDashboard();
                renderCharts();
                renderMeritCharts();
                renderRecords();
                renderAdvancedAnalytics();
                refreshAllPrefectUI();

                const successCount = Object.values(lastSuccessfulSheetFetch).filter(Boolean).length;
                if (successCount === 6) {
                    showToast(`✅ Synced successfully. ${prefects.length} prefect(s) loaded from Google Sheets.`);
                } else {
                    showToast(`⚠️ Sync completed with ${successCount}/6 sheets available. Check the console if needed.`);
                }
            } catch (error) {
                console.error("Sync error:", error);
                showToast("❌ Sync failed. Local data was kept.");
            } finally {
                isSyncing = false;
                if (syncBtn) {
                    syncBtn.disabled = false;
                    syncBtn.innerHTML = originalText;
                }
            }
        }

