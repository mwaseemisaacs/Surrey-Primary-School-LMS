        function renderPrefects() {
            const tbody = document.getElementById('prefectTableBody');
            if (!tbody) return;
            const searchEl = document.getElementById('prefectSearchInput');
            const statusEl = document.getElementById('prefectStatusFilter');
            const roleEl = document.getElementById('prefectRoleFilter');
            const search = searchEl ? searchEl.value.toLowerCase().trim() : '';
            const statusFilter = statusEl ? statusEl.value : 'ALL';
            const roleFilter = roleEl ? roleEl.value : 'ALL';

            let filtered = [...prefects];
            if (search) filtered = filtered.filter(p => String(p.name || '').toLowerCase().includes(search));
            if (statusFilter !== 'ALL') filtered = filtered.filter(p => p.status === statusFilter);
            if (roleFilter !== 'ALL') filtered = filtered.filter(p => p.role === roleFilter);

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="no-data">No prefects found.</td></tr>`;
                return;
            }

            filtered.sort((a, b) => (a.order || 0) - (b.order || 0));

            tbody.innerHTML = filtered.map((p, idx) => {
                const rowClass = p.status === 'Active' ? 'prefect-active' :
                    p.status === 'Suspended' ? 'prefect-suspended' :
                    p.status === 'Removed' ? 'prefect-removed' : '';
                const isHead = p.role === 'Head Boy' || p.role === 'Head Girl';
