        function updateDashboard() {
            const infractions = records.filter(r => r.record_type !== 'merit' && r.record_type !== 'parent_info' && r
                .severity !== 'Merit Award');
            const merits = records.filter(r => r.record_type === 'merit');
            document.getElementById('landingTotalInfractions').innerText = infractions.length;
            document.getElementById('landingTotalMerits').innerText = merits.length;
            document.getElementById('statTotal').innerText = infractions.length;
            if (records.length === 0) {
                document.getElementById('statCommonGrade').innerText = 'N/A';
                document.getElementById('statRepeatOffenders').innerText = '0';
                document.getElementById('statTopLocation').innerText = 'N/A';
                return;
            }
            const gradeCounts = {};
            const locationCounts = {};
            infractions.forEach(r => {
                if (r.grade) gradeCounts[r.grade] = (gradeCounts[r.grade] || 0) + 1;
                if (r.location) locationCounts[r.location] = (locationCounts[r.location] || 0) + 1;
            });
            let topGrade = 'N/A',
                maxG = 0;
            for (const [g, c] of Object.entries(gradeCounts)) { if (c > maxG) { maxG = c;
                    topGrade = g; } }
            document.getElementById('statCommonGrade').innerText = topGrade;
            let topLoc = 'N/A',
                maxL = 0;
            for (const [l, c] of Object.entries(locationCounts)) { if (c > maxL) { maxL = c;
                    topLoc = l; } }
            document.getElementById('statTopLocation').innerText = topLoc;
            let repeatCount = 0;
            for (const count of Object.values(learnerCounts)) { if (count >= 3) repeatCount++; }
            document.getElementById('statRepeatOffenders').innerText = repeatCount;
        }

        // ========== RENDER CHARTS ==========
        function renderCharts() {
            const gradeCounts = {};
            let ordinaryCount = 0,
                seriousCount = 0;
            const categoryCounts = {};
            const locationCounts = {};
            const statusCounts = {};
            const dayCounts = { "Monday": 0, "Tuesday": 0, "Wednesday": 0, "Thursday": 0, "Friday": 0 };
            const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

            records.forEach(r => {
                if (r.record_type !== 'parent_info' && r.record_type !== 'merit' && r.severity !== 'Merit Award') {
                    if (r.grade) gradeCounts[r.grade] = (gradeCounts[r.grade] || 0) + 1;
                    if (r.severity && r.severity.includes("Serious")) seriousCount++;
                    else ordinaryCount++;
                    if (r.category) categoryCounts[r.category] = (categoryCounts[r.category] || 0) + 1;
                    if (r.location) locationCounts[r.location] = (locationCounts[r.location] || 0) + 1;
                    if (r.intervention_status) statusCounts[r.intervention_status] = (statusCounts[r.intervention_status] ||
                        0) + 1;
                    if (r.date) {
                        const dateObj = parseLocalDate(r.date);
                        if (dateObj && !isNaN(dateObj)) {
                            const dayName = days[dateObj.getDay()];
                            if (dayCounts[dayName] !== undefined) dayCounts[dayName]++;
                        }
                    }
                }
            });

            const sortedGrades = Object.keys(gradeCounts).sort();
            if (chartInstances.grade) chartInstances.grade.destroy();
            chartInstances.grade = new Chart(document.getElementById('gradeChart'), {
                type: 'bar',
